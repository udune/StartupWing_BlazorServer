@page "/DocumentManage"
@rendermode InteractiveServer
@using StartupWing_BlazorServer.Components.Manager
@using StartupWing_BlazorServer.Components.Services
@using StartupWing_BlazorServer.Components.Templates
@using StartupWing_BlazorServer.Components.Modals
@inject DataManager DataManager
@inject APIService APIService

<div class="title-text">서류관리</div>
<br/>
<div class="title-sub-text">서류를 확인하고 업로드 할 수 있습니다.</div>
<br/><br/>

<SearchTemplate OnSearchAction="OnSearch"
                OnChangeAction="OnChange"
                ButtonAction="AddDocument"
                ButtonText="서류 추가"
                SortByAscendingAction="SortByAscending"
                SortByDescendingAction="SortByDescending">
</SearchTemplate>

<TableTemplate @ref="table"
               ApiDatas="_apiDatas"
               PageDatas="_pageDatas"
               TableDatas="_tableDatas"
               UpdateEvent="UpdatePageData">
    <Header>
        <th class="table-header-item" style="width:120px;">관리번호</th>
        <th class="table-header-item" style="width:270px;">문서명</th>
        <th class="table-header-item" style="width:270px;">파일(다운로드)</th>
        <th class="table-header-item" style="width:120px;">작성일</th>
        <th class="table-header-item" style="width:120px;">유효기간</th>
        <th class="table-header-item" style="width:120px;">공개 범위</th>
        <th class="table-header-item" style="width:120px;">비고</th>
    </Header>
    <Row Context="item">
        <td class="table-body-item" style="width:120px;">@item.Id</td>
        <td class="table-body-item" style="width:270px;">@item.Title</td>
        <td class="table-body-item" style="width:270px;"><NavLink class="nav-link" href="@item.FileData[0].Url">@item.FileData[0].FileName</NavLink></td>
        <td class="table-body-item" style="width:120px;">@item.CreatedTime.ToString("yyyy-MM-dd")</td>
        <td class="table-body-item" style="width:120px;">@item.ExpireAt.ToString("yyyy-MM-dd")</td>
        <td class="table-body-item" style="width:120px;">@(item.IsPublic ? "전체":"대외비")</td>
        <td class="table-body-item" style="width:120px;">@item.Note</td>
    </Row>
</TableTemplate>

<Modal @ref="addDocument" />
<Modal @ref="popup" />