@using ApexCharts
@using StartupWing_BlazorServer.Components.Services
@inject GoogleSheetsService GoogleSheetsService

@if (on)
{
    <div class="chart-container">
        <span class="chart-title">@title</span>
        <div class="chart-line"></div>
        <div class="chart">
            <ApexChart Options=@option>
                <ApexPointSeries Items="MonthlyPerformanceManagement_Datas" Name=@Section_Datas[0] XValue="@(item => item.Month)" YValue="@(item => Convert.ToDecimal(item.Income))" SeriesType="SeriesType.Bar" Color="#0099FF"/>
                <ApexPointSeries Items="MonthlyPerformanceManagement_Datas" Name=@Section_Datas[1] XValue="@(item => item.Month)" YValue="@(item => Convert.ToDecimal(item.Spending))" SeriesType="SeriesType.Bar" Color="#FFD16D"/>
                <ApexPointSeries Items="MonthlyPerformanceManagement_Datas" Name=@Section_Datas[2] XValue="@(item => item.Month)" YValue="@(item => Convert.ToDecimal(item.NetProfit))" SeriesType="SeriesType.Line" Color="#FF6D6D"/>
            </ApexChart>
        </div>
    </div>
}