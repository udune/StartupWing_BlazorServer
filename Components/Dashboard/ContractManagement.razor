@using StartupWing_BlazorServer.Components.Services
@inject GoogleSheetsService GoogleSheetsService

@if (on)
{
    <div class="chart-container">
        <span class="chart-title">@title</span>
        <div class="chart-line"></div>
        <span class="chart-unit">@unit</span>
        <table>
            <thead>
                <tr>
                    @foreach (var th in ContractManagement_Data[1])
                    {
                        <th class="th">@th</th>
                    }
                </tr>
            </thead>
            <tbody>
            @for (int tr = 2; tr < ContractManagement_Data.Count; tr++)
            {
                <tr>
                    @foreach (var td in ContractManagement_Data[tr])
                    {
                        <td class="td">@td</td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}